# LBA CLOUD v3.0 — example environment (no real secrets committed)
APP_NAME="LBA Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Phase 2A: tenant clinical databases (isolated per tenant) ---------------
# Runtime tenant credential must be SEPARATE from the central credential.
# Provisioning uses the central/privileged connection (TENANCY_PROVISIONING_CONNECTION).
TENANT_DB_CONNECTION=sqlite
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=
# TENANT_DB_PASSWORD=
TENANT_DB_PREFIX=lba_tenant_
# For sqlite tenants, one file per tenant is created under this directory.
TENANT_DB_SQLITE_PATH=

# --- Staging: ONE tenant on a manually-created MySQL database ----------------
# Optional and OFF unless BOTH values below are set. When both are set, ONLY
# the tenant whose ULID equals TENANT_DB_TENANT_ID uses the physical database
# named by TENANT_DB — created BY HAND in cPanel — while every other tenant
# keeps its derived name. This mode NEVER calls the cPanel UAPI and never
# creates the database. The connection uses TENANT_DB_HOST / TENANT_DB_PORT /
# TENANT_DB_USERNAME / TENANT_DB_PASSWORD above (a temporary staging MySQL user
# that already has rights on the database is fine; use a dedicated per-tenant
# MySQL account for a permanent setup). The name is validated and may never be
# the central database.
# TENANT_DB=lbacloud_tenant
# TENANT_DB_TENANT_ID=01JXXXXXXXXXXXXXXXXXXXXXXX

# --- Phase 3: cPanel provisioning adapter (server-side only) -----------------
# When enabled, tenant databases are created via the cPanel UAPI. cPanel owns
# the privileged DDL and grants the RESTRICTED runtime user (TENANT_DB_USERNAME)
# privileges ON THE TENANT DATABASE ONLY — the Laravel runtime credential is
# never given a global CREATE privilege. These credentials must NEVER be exposed
# to the browser or committed to source control.
CPANEL_PROVISIONING_ENABLED=false
# CPANEL_HOST=server.example.com
# CPANEL_PORT=2083
# CPANEL_USERNAME=cpaccount
# CPANEL_API_TOKEN=
# The unprefixed MySQL user the runtime connection authenticates as.
# CPANEL_RUNTIME_DB_USER=
# CPANEL_SCHEME=https
# CPANEL_VERIFY_TLS=true
# CPANEL_TIMEOUT=20

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
