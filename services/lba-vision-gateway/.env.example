# LBA Vision Gateway — example environment. Copy to `.env` and fill in locally.
# NEVER commit a real secret.

# Preferred: a JSON map of key id -> shared secret.
# LBA_GATEWAY_KEYS={"dev-key":"dev-secret-change-me"}

# Fallback single-credential form.
LBA_GATEWAY_KEY_ID=dev-key
LBA_GATEWAY_SECRET=dev-secret-change-me

# Replay window for the signed timestamp, in seconds.
LBA_GATEWAY_SIGNATURE_TTL=300

# Synthetic mock adapter only (no model, no diagnosis).
LBA_GATEWAY_PROVIDER=mock
LBA_GATEWAY_MODEL_NAME=lba-vision-synthetic
LBA_GATEWAY_MODEL_VERSION=0.0.0-synthetic
